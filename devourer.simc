# Devourer Demon Hunter, Midnight 12.1.5 PTR

ptr=1
desired_targets=1
max_time=300
override.bloodlust=1
target_error=0.05

demonhunter="Devourer"
spec=devourer
level=90
race=void_elf
timeofday=night
role=spell
position=back
omnium_talents=136822:1/136819:1/136817:1/136818:1/136814:1

# Void-Scarred
potion=potion_of_recklessness_2
flask=flask_of_the_magisters_2
food=blooming_feast
augmentation=void_touched
temporary_enchant=main_hand:thalassian_phoenix_oil_2/off_hand:thalassian_phoenix_oil_2
head=gaze_of_the_coiled_watcher,id=271875,ilevel=344,bonus_id=13847/13668,gem_id=240898,enchant_id=7991
talents=CgcBAAAAAAAAAAAAAAAAAAAAAAAWMzMzMzMzMwMAAAAAAALzYMYGAAAAAAAAmxMMmZmZYmZYmlZGjNttAgAGAjZmZbmZa2mZbmhxMGA
set_bonus=midnight_season_2_2pc=1
set_bonus=midnight_season_2_4pc=1
neck=aqirbane_reliquary,id=268265,ilevel=344,bonus_id=13668/13708,gem_id=240967/240890
shoulder=somber_spaulders,id=251223,ilevel=334,enchant_id=8031
back=silken_voodoo_drape,id=268253,ilevel=344
chest=chestwrap_of_palpable_terror,id=281236,bonus_id=14049,ilevel=344,enchant_id=7987
wrist=silvermoon_agents_deflectors,id=244576,ilevel=331,bonus_id=8960/12214/12384/13751/13836/9627/13668,gem_id=240890,crafted_stats=32/36
hands=abyssal_doomhounds_studded_gauntlets,id=271538,ilevel=334
waist=sash_of_the_forlorn_vessel,id=268256,ilevel=344,bonus_id=13668,gem_id=240918
legs=coiled_hex_legguards,id=268225,ilevel=344,enchant_id=7935
feet=silvermoon_agents_sneakers,id=244569,ilevel=331,bonus_id=8960/12214/12384/13751/13836/9627,crafted_stats=32/36,enchant_id=7993
finger1=charged_sandstone_band,id=158366,ilevel=334,bonus_id=13750,gem_id=240890,enchant_id=7967
finger2=vile_alchemists_band,id=268249,ilevel=334,bonus_id=13668,gem_id=240908,enchant_id=7967
trinket1=twisted_horrors_tendril,id=281215,ilevel=344
trinket2=wavecallers_seastone,id=270167,ilevel=334
main_hand=janthrazet_the_soul_fang,id=271092,ilevel=344,enchant_id=8041
off_hand=baleful_hexblade,id=268211,ilevel=344,enchant_id=8041

# Annihilator (comment out the Void-Scarred block above, uncomment this)
