# Temple of Sethraliss — Mythic+ dungeon route (Midnight Season 2).
# Pull composition, chaining, travel times, and mob health from 12.1 PTR logs.
# Health is at a +15 keystone, scaled for a single actor; for another key level
# multiply by 1.1 per level. Bloodlust fires on pull 1 and Galvazzt.
#
# Usage:  simc devourer.simc temple-of-sethraliss-route.simc
fight_style=DungeonRoute
max_time=3000
vary_combat_length=0
desired_targets=1
override.bloodlust=0

enemy=DungeonRoute_TempleOfSethraliss
enemy_health=999999
dungeon_route_smart_targeting=1
raid_events=/invulnerable,cooldown=6000,duration=6000,retarget=1
